# Supabase (Projekt anlegen auf supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# 32 Byte Schlüssel zum Verschlüsseln der Kunden-API-Keys.
# Erzeugen mit: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NIEMALS ändern, sobald Kunden Schlüssel gespeichert haben – sonst sind sie nicht mehr lesbar.
ENCRYPTION_KEY=

# Optional: Claude-Modell für die Agenten (Standard: claude-sonnet-5-5)
AGENT_MODEL=claude-sonnet-5-5

# Öffentliche Adresse der App (für Bestätigungs-Mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
